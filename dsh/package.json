{
  "name": "dsh-progress-target",
  "version": "2.1.0",
  "author": "02TJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/02TJS/ProgressTarget.git",
    "directory": "dsh"
  },
  "homepage": "https://github.com/02TJS/ProgressTarget/tree/main/dsh#readme",
  "bugs": { "url": "https://github.com/02TJS/ProgressTarget/issues" },
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "peerDependencies": { "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh": { "optional": true } },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": { "test": "node --test test/*.test.js" },
  "description": "Persistent, quality-gated, resource-aware execution plans for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "experiment-tracking",
    "gpu-scheduling",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "GUIDE.zh-CN.md",
    "CONFIGURATION.md",
    "PROMPT.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.zh-CN.md",
    "V2-CONTRACT.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
